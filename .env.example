# Postgres. En Railway se referencia el servicio de base de datos con
# ${{Postgres.DATABASE_URL}} para usar la red privada del proyecto.
DATABASE_URL=postgresql://postgres:password@localhost:5432/cuantohacede

# Solo si DATABASE_URL apunta al rol sin privilegios de db/create-app-role.sql:
# las migraciones crean tablas y necesitan un rol que pueda hacerlo.
# MIGRATION_DATABASE_URL=postgresql://postgres:password@localhost:5432/cuantohacede

# Ponlo a true solo si la conexión sale a internet y exige TLS. Dentro de la
# red privada de Railway no hace falta.
# DATABASE_SSL=true

# Tamaño del pool de conexiones (por defecto 10).
# DATABASE_POOL_MAX=10

# Clave con la que se firma la cookie de sesión. Mínimo 32 caracteres:
#   openssl rand -base64 32
SESSION_SECRET=genera-una-clave-de-al-menos-32-caracteres
